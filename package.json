{
  "name": "technocore",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript client for the Technocore signed lane",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"const f=\\\"dist/cli.js\\\",s=require(\\\"fs\\\");s.writeFileSync(f,\\\"#\\\"+\\\"!/usr/bin/env node\\\\n\\\"+s.readFileSync(f,\\\"utf8\\\"));s.chmodSync(f,0o755)\""
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "types": "dist/index.d.ts",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "compilerOptions": null,
  "bin": {
    "technocore": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
